{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "reload_style_on_change": true,

  "modules-left":   ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["custom/updates", "cpu", "memory", "network", "pulseaudio", "custom/power"],

  "hyprland/workspaces": { "format": "{id}", "on-click": "activate" },
  "hyprland/window":     { "max-length": 50 },

  "clock": {
    "format": "  {:%H:%M:%S}",
    "format-alt": "  {:%a, %d %b %Y}",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#f5e0dc'><b>{}</b></span>",
        "days":     "<span color='#cdd6f4'>{}</span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today":    "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
  },

  "custom/updates": {
    "exec": "waybar-updates",
    "return-type": "json",
    "interval": 1800,
    "signal": 8,
    "on-click": "waybar-updates --run"
  },

  "cpu": { "format": "  {usage}%", "interval": 2 },

  "memory": {
    "format": "  {percentage}%",
    "interval": 5,
    "tooltip-format": "RAM   {used:0.1f} / {total:0.1f} GiB\nSwap  {swapUsed:0.1f} / {swapTotal:0.1f} GiB"
  },

  "network": {
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰈂  off",
    "interval": 2,
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}\n⇣ {bandwidthDownBytes}   ⇡ {bandwidthUpBytes}"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  mute",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "powermenu"
  }
}
