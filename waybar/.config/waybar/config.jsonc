{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "reload_style_on_change": true,

  "modules-left":   ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["cpu", "memory", "network", "pulseaudio"],

  "hyprland/workspaces": { "format": "{id}", "on-click": "activate" },
  "hyprland/window":     { "max-length": 50 },

  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%a, %d %b %Y}",
    "tooltip": false
  },
  "cpu":    { "format": "  {usage}%", "interval": 2 },
  "memory": { "format": "  {percentage}%", "interval": 5 },
  "network": {
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰈂  off",
    "tooltip-format": "{ifname}"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  mute",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] }
  }
}
